# =============================================================
# Kawader Backend — Environment Template
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to `.env`
# 2. Replace the placeholder values below with the actual secrets.
# 3. DO NOT commit the `.env` file to version control.
# =============================================================

# ─────────────────────────────────────────
# ngrok
# ─────────────────────────────────────────
NGROK_AUTHTOKEN=your_ngrok_token_here

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JwtSettings__Secret=your_jwt_secret_key_here_must_be_long

# ─────────────────────────────────────────
# Azure Storage
# ─────────────────────────────────────────
Azure__StorageAccountName=your_storage_account_name
Azure__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ─────────────────────────────────────────
# Google Gemini
# ─────────────────────────────────────────
Gemini__ApiKey=your_gemini_api_key_here

# ─────────────────────────────────────────
# Database Connection Strings
# ─────────────────────────────────────────
ConnectionStrings__MonsterAsp=Server=...; Database=...; User Id=...; Password=...; Encrypt=True; TrustServerCertificate=True;
ConnectionStrings__Redis=localhost:6379

# ─────────────────────────────────────────
# RabbitMQ (app settings + compose service)
# ─────────────────────────────────────────
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─────────────────────────────────────────
# SMTP (Mailtrap)
# ─────────────────────────────────────────
Smtp__Username=your_smtp_username
Smtp__Password=your_smtp_password

# ─────────────────────────────────────────
# Paymob
# ─────────────────────────────────────────
Paymob__ApiKey=your_paymob_api_key
Paymob__PublicKey=your_paymob_public_key
Paymob__SecretKey=your_paymob_secret_key
Paymob__HMAC=your_paymob_hmac

# ─────────────────────────────────────────
# Grafana (compose service credentials)
# ─────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# ─────────────────────────────────────────
# Gorse Postgres (compose service credentials)
# ─────────────────────────────────────────
GORSE_DB_USER=gorse
GORSE_DB_PASSWORD=gorse_password
