{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/kawadar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "app",
              "value": "kawadar-api"
            },
            {
              "key": "environment",
              "value": "development"
            }
          ],
          "propertiesAsLabels": ["level"]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "Kawadar.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Azure": {
    "StorageAccountName": "SET_IN_ENVIRONMENT",
    "ConnectionString": "SET_IN_ENVIRONMENT"
  },
  "Gemini": {
    "ApiKey": "SET_IN_ENVIRONMENT"
  },

  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "SET_IN_ENVIRONMENT",
    "Password": "SET_IN_ENVIRONMENT"
  },
  "ConnectionStrings": {
    "MonsterAsp": "SET_IN_ENVIRONMENT",
    "Redis": "SET_IN_ENVIRONMENT"
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "CorsPolicyName": "KawadarCorsPolicy",
    "AllowedOrigins": ["http://localhost:5173", "http://kawadar-app"]
  },
  "FrontUrl": "http://localhost:5000",
  "BackUrl": "https://localhost:7093",
  "JwtSettings": {
    "Secret": "SET_IN_ENVIRONMENT",
    "TokenExpirationInMinutes": 60,
    "Issuer": "localhost",
    "Audience": "localhost"
  },
  "Gorse": {
    "BaseUri": "http://gorse:8088",
    "ApiKey": "change-me",
    "DefaultRecommendationCount": 10
  },
  "Smtp": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 587,
    "EnableSsl": true,
    "Username": "SET_IN_ENVIRONMENT",
    "Password": "SET_IN_ENVIRONMENT",
    "From": "noreply@kawadar.com"
  },
  "Paymob": {
    "ApiKey": "SET_IN_ENVIRONMENT",
    "PublicKey": "SET_IN_ENVIRONMENT",
    "SecretKey": "SET_IN_ENVIRONMENT",
    "HMAC": "SET_IN_ENVIRONMENT"
  },
  "Ollama": {
    "BaseUrl": "http://ollama:11434",
    "EmbeddingModel": "bge-m3",
    "ChatModel": "qwen3.5:0.8b"
  },
  "Qdrant": {
    "Host": "qdrant",
    "Port": "6334"
  }
}
